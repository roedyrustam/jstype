{
  "name": "@jstype/client",
  "version": "1.0.0",
  "description": "Zero-overhead typed RPC client for jstype",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "author": "Roedy Rustam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roedyrustam/jstype.git",
    "directory": "packages/client"
  },
  "bugs": {
    "url": "https://github.com/roedyrustam/jstype/issues"
  },
  "homepage": "https://github.com/roedyrustam/jstype#readme",
  "keywords": [
    "jstype",
    "rpc-client",
    "typed-client",
    "proxy",
    "typescript",
    "fetch",
    "zero-codegen"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@jstype/core": "workspace:*",
    "tsup": "^8.3.6",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
