{
  "name": "@jstype/core",
  "version": "1.0.0",
  "description": "Ultra-fast Web Standards web framework with end-to-end type safety",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "author": "Roedy Rustam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roedyrustam/jstype.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/roedyrustam/jstype/issues"
  },
  "homepage": "https://github.com/roedyrustam/jstype#readme",
  "keywords": [
    "jstype",
    "web-framework",
    "typescript",
    "type-safe",
    "rpc",
    "fetch-api",
    "radix-router",
    "openapi",
    "scalar",
    "sse",
    "streaming"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7",
    "zod": "^4.6.5"
  }
}
