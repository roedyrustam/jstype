{
  "name": "jstype-node",
  "version": "1.0.0",
  "description": "Node.js HTTP Server Adapter & Static File Middleware for jstype",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "author": "Roedy Rustam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roedyrustam/jstype.git",
    "directory": "packages/node"
  },
  "bugs": {
    "url": "https://github.com/roedyrustam/jstype/issues"
  },
  "homepage": "https://github.com/roedyrustam/jstype#readme",
  "keywords": [
    "jstype",
    "node",
    "server-adapter",
    "http",
    "static-files",
    "fetch-adapter"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "jstype-core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
